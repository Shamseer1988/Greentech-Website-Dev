[Unit]
Description=Green Tech website (Next.js)
After=network-online.target greentech-backend.service
Wants=network-online.target

[Service]
User=greentech
Group=greentech
WorkingDirectory=/opt/greentech/app/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 0.0.0.0 -p 3000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
