# Copy to .env.local and fill in. Empty values show a placeholder on the site.

# Where the Next.js server finds the backend and the photos
API_URL=http://127.0.0.1:8000
MEDIA_PUBLIC_URL=http://127.0.0.1:9000/greentech-media
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phone numbers with country code, e.g. +97455555555
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_OFFICE_ADDRESS_EN=
NEXT_PUBLIC_OFFICE_ADDRESS_AR=
NEXT_PUBLIC_OFFICE_HOURS=
# Office map point, e.g. 25.2854,51.5310
NEXT_PUBLIC_OFFICE_LATLNG=
NEXT_PUBLIC_CR_NUMBER=

NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_FACEBOOK=
NEXT_PUBLIC_YOUTUBE=
NEXT_PUBLIC_TIKTOK=
NEXT_PUBLIC_PROPERTY_FINDER=
NEXT_PUBLIC_QATAR_LIVING=
NEXT_PUBLIC_MZAD_QATAR=
