# Copy this file to .env and change the passwords. Never commit .env.
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL (use 127.0.0.1: on Windows "localhost" can hang on IPv6)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=greentech
POSTGRES_USER=greentech
POSTGRES_PASSWORD=change-me

# MinIO (password must be at least 8 characters)
MINIO_ROOT_USER=greentech
MINIO_ROOT_PASSWORD=change-me-too
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=greentech-media
MEDIA_PUBLIC_URL=http://127.0.0.1:9000/greentech-media

# Signs admin logins. Use a long random value (at least 32 characters) and keep it secret.
JWT_SECRET=
LOGIN_HOURS=8

# Enquiries allowed per visitor IP in the time window
ENQUIRY_LIMIT=5
ENQUIRY_WINDOW_SECONDS=600

# The website's public address, for links in emails and posts
SITE_URL=http://localhost:3000

# --- Optional: leave empty to switch off ---

# Email alert for each new enquiry. SMTP_SECURITY: starttls (port 587), ssl (port 465) or none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# Example: ENQUIRY_EMAIL_TO=["info@example.com","sales@example.com"]
ENQUIRY_EMAIL_TO=[]

# Cloudflare Turnstile (stops spam forms). Needs NEXT_PUBLIC_TURNSTILE_SITE_KEY in frontend/.env.local too
TURNSTILE_SECRET=

# Facebook and Instagram posts from the admin panel
META_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ID=
