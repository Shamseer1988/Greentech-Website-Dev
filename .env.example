# Copy this file to .env and change the passwords. Never commit .env.
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL (use 127.0.0.1: on Windows "localhost" can hang on IPv6)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=greentech
POSTGRES_USER=greentech
POSTGRES_PASSWORD=change-me

# MinIO (password must be at least 8 characters)
MINIO_ROOT_USER=greentech
MINIO_ROOT_PASSWORD=change-me-too
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=greentech-media
MEDIA_PUBLIC_URL=http://127.0.0.1:9000/greentech-media

# Temporary key for photo uploads until admin login (Phase 4). Long random value; empty = uploads off.
ADMIN_API_KEY=

# Enquiries allowed per visitor IP in the time window
ENQUIRY_LIMIT=5
ENQUIRY_WINDOW_SECONDS=600
